# HTTP server
PORT=8080
ENV=development

# Postgres connection string
DATABASE_URL=postgres://amri@localhost:5432/kommers?sslmode=disable

# JWT auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY_HOURS=24

# Auth cookie (httpOnly) — set alongside the JSON token response
# COOKIE_DOMAIN empty = host-only cookie, fine for local dev
COOKIE_DOMAIN=
# COOKIE_SECURE defaults to `false` in development, `true` otherwise —
# only set explicitly to override that default
# COOKIE_SECURE=true

# CORS — comma-separated list of allowed origins (the web app)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# RabbitMQ — order.created events, optional (checkout works without it)
RABBITMQ_URL=amqp://kommers:kommers@localhost:5672/
